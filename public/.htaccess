# Single-page app fallback (Apache / cPanel / Hostinger / shared hosting):
# any URL without a real file or folder gets index.html, so client-side
# routes like /admin work on a live server.

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Never rewrite requests that already point at a real file or directory
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d

  RewriteRule . /index.html [L]
</IfModule>
